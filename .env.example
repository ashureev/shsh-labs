# =============================================================
# SHSH 2.0 Playground — Local Environment Configuration
# =============================================================
# Copy this file: cp .env.example .env

# ─── Universal LLM Configuration ──────────────────────────────
# Provider options: "ollama", "gemini", "openai", "openrouter"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# 1. For Local Offline Ollama (Default):
OLLAMA_BASE_URL=http://localhost:11434/v1

# 2. For Google Gemini (Free API Key from https://aistudio.google.com/apikey):
# GOOGLE_API_KEY=your_gemini_key_here
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# 3. For OpenAI / OpenRouter:
# OPENAI_API_KEY=your_openai_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here

# ─── Core Application Settings ────────────────────────────────
PORT=8080
DB_PATH=./data/shsh.db

# Container runtime: "" = standard Docker, "runsc" = gVisor sandbox
CONTAINER_RUNTIME=

# ─── Container Resource Limits & Timeouts ─────────────────────
SHSH_CONTAINER_MEMORY_LIMIT=536870912
SHSH_CONTAINER_CPU_QUOTA=50000
SHSH_CONTAINER_PIDS_LIMIT=256
SHSH_TTL_WORKER_INTERVAL=5m
