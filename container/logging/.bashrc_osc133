#!/bin/bash
# =============================================================================
# SHSH Session Logging & OSC 133 Shell Integration
# Powered by bash-preexec for clean, exact user command capture
# =============================================================================

# Only avoid double loading
[[ -n "$_SHSH_LOGGING_LOADED" ]] && return
_SHSH_LOGGING_LOADED=1

# Helper for base64 encoding without newlines
_shsh_b64() {
    printf '%s' "$1" | base64 | tr -d '\n\r'
}

# =============================================================================
# OSC 133 Shell Integration Emitters
# =============================================================================

_shsh_osc133_prompt_start() {
    local pwd_b64
    pwd_b64=$(_shsh_b64 "$PWD")
    printf "\033]133;A;pwd=%s\007" "$pwd_b64"
}

_shsh_osc133_preexec() {
    local cmd="$1"
    local cmd_b64 pwd_b64
    cmd_b64=$(_shsh_b64 "$cmd")
    pwd_b64=$(_shsh_b64 "$PWD")
    printf "\033]133;B;cmd=%s;pwd=%s\007" "$cmd_b64" "$pwd_b64"
}

_shsh_osc133_postexec() {
    local exit_code=$1
    local dur_ms=$2
    local cmd="$3"
    local cmd_b64 pwd_b64
    cmd_b64=$(_shsh_b64 "$cmd")
    pwd_b64=$(_shsh_b64 "$PWD")
    printf "\033]133;D;exit=%d;dur=%d;cmd=%s;pwd=%s\007" "$exit_code" "$dur_ms" "$cmd_b64" "$pwd_b64"
}

# =============================================================================
# bash-preexec Integration
# =============================================================================

_SHSH_LAST_CMD=""
_SHSH_START_TIME=""

_shsh_is_ignored_cmd() {
    local cmd="$1"
    [[ -z "$cmd" ]] && return 0
    [[ "$cmd" == _shsh_* ]] && return 0
    [[ "$cmd" == shsh_* ]] && return 0
    [[ "$cmd" == "PROMPT_COMMAND="* ]] && return 0
    [[ "$cmd" == "source "* ]] && return 0
    [[ "$cmd" == ". "* ]] && return 0
    [[ "$cmd" == "trap "* ]] && return 0
    [[ "$cmd" == "["* ]] && return 0
    [[ "$cmd" == "test "* ]] && return 0
    return 1
}

# Called by bash-preexec BEFORE executing an interactive user command
_shsh_preexec_hook() {
    local cmd="$1"
    if _shsh_is_ignored_cmd "$cmd"; then
        _SHSH_LAST_CMD=""
        _SHSH_START_TIME=""
        return 0
    fi

    _SHSH_LAST_CMD="$cmd"
    _SHSH_START_TIME=$(date +%s%3N 2>/dev/null || echo 0)
    _shsh_osc133_preexec "$_SHSH_LAST_CMD"
}

# Called by bash-preexec / PROMPT_COMMAND AFTER command completes
_shsh_precmd_hook() {
    local exit_code=$?
    local saved_exit=$exit_code

    if [[ -n "$_SHSH_LAST_CMD" ]]; then
        local duration_ms=0
        if [[ -n "$_SHSH_START_TIME" && "$_SHSH_START_TIME" -gt 0 ]]; then
            local end_time
            end_time=$(date +%s%3N 2>/dev/null || echo 0)
            if [[ "$end_time" -gt "$_SHSH_START_TIME" ]]; then
                duration_ms=$((end_time - _SHSH_START_TIME))
            fi
        fi

        _shsh_osc133_postexec "$saved_exit" "$duration_ms" "$_SHSH_LAST_CMD"
        _SHSH_LAST_CMD=""
        _SHSH_START_TIME=""
    fi

    # Emit prompt start marker
    _shsh_osc133_prompt_start
    return $saved_exit
}

# Load bash-preexec if available and register hooks
if [[ -f /opt/bash-preexec/bash-preexec.sh ]]; then
    source /opt/bash-preexec/bash-preexec.sh
    preexec_functions+=(_shsh_preexec_hook)
    precmd_functions+=(_shsh_precmd_hook)
else
    # Fallback to PROMPT_COMMAND if bash-preexec missing
    PROMPT_COMMAND="_shsh_precmd_hook${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi

# Set custom prompt styling
prompt_color="\[\033[38;2;99;102;241m\]"
reset_color="\[\033[0m\]"
path_color="\[\033[38;2;42;157;143m\]"
PS1="${prompt_color}\u@\h${reset_color}:${path_color}\w${reset_color}\$ "